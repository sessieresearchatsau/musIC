Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Successor", "[", 
    RowBox[{"{", 
     RowBox[{"n_Integer", ",", "d_Integer"}], "}"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"d", "==", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"(", 
        RowBox[{"n", "+", "1"}], ")"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "+", "1"}], ")"}], ",", 
       RowBox[{"(", 
        RowBox[{"d", "-", "1"}], ")"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"display", "[", 
    RowBox[{"{", 
     RowBox[{"n_", ",", "d_"}], "}"}], "]"}], ":=", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"n", "==", "d", "==", "6"}], 
       ",", "\"\<\[DescendingEllipsis]\>\"", ",", 
       RowBox[{"n", "==", "6"}], ",", "\"\<\[CenterEllipsis]\>\"", ",", 
       RowBox[{"d", "==", "6"}], ",", "\"\<\[VerticalEllipsis]\>\"", ",", 
       "True", ",", 
       RowBox[{"ToString", "@", 
        RowBox[{"Row", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"n", ",", "d"}], "}"}], ",", "\"\</\>\""}], "]"}]}]}], 
      "]"}], ",", "20"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"edges", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"DeleteCases", "[", 
       RowBox[{"#1", ",", "Null"}], "]"}], "&"}], ")"}], "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"n", ",", "d"}], "}"}], "\[DirectedEdge]", 
           RowBox[{"{", 
            RowBox[{"n", ",", "d"}], "}"}]}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"n", "<=", "7"}], "&&", 
              RowBox[{"d", "<=", "7"}], "&&", 
              RowBox[{
               RowBox[{"n", "+", "d"}], "<=", "6"}], "&&", 
              RowBox[{"n", "<", "6"}]}], ")"}], ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"n", ",", "d"}], "}"}], "->", 
             RowBox[{"Successor", "[", 
              RowBox[{"{", 
               RowBox[{"n", ",", "d"}], "}"}], "]"}]}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "1", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "6"}], "}"}]}], "]"}], ",", "3"}], "]"}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graph", "[", 
  RowBox[{"edges", ",", 
   RowBox[{"VertexCoordinates", "->", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", "d"}], "}"}], "->", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"6", "-", "d"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "1", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "6"}], "}"}]}], "]"}], ",", "1"}], 
     "]"}]}], ",", 
   RowBox[{"VertexShapeFunction", "->", 
    RowBox[{"(", 
