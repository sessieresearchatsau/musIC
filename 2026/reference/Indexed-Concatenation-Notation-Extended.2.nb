Cell[BoxData[
 RowBox[{"{", 
  TagBox[
   RowBox[{
    UnderoverscriptBox["\[Euro]", 
     RowBox[{"k", "\[DoubleRightTee]", "1"}], "\[Infinity]"], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "2", ",", "2"}], "}"}], ",", 
     TagBox[
      RowBox[{
       UnderoverscriptBox["\[Euro]", 
        RowBox[{"j", "\[DoubleRightTee]", "1"}], "2"], "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", 
         RowBox[{"2", " ", "j"}]}], "}"}], "]"}],
      DisplayForm], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{
        RowBox[{"2", " ", "k"}], "+", "3"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     TagBox[
      RowBox[{
       UnderoverscriptBox["\[Euro]", 
        RowBox[{"i", "\[DoubleRightTee]", "1"}], 
        RowBox[{"2", "k"}]], "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{
          RowBox[{"2", " ", "k"}], "+", "8"}]}], "}"}], "]"}],
      DisplayForm], ",", 
     RowBox[{"{", "}"}]}], "]"}],
   DisplayForm], "}"}]], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.941920525747004*^9, 3.941920570317734*^9}, 
   3.941920606808317*^9, {3.941941201212618*^9, 
   3.941941205900563*^9}},ExpressionUUID->"439d5ba8-5fbd-244b-b312-\
a478aff6f508"]
}, Open  ]],

Cell[TextData[{
 "Note the index variables, ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "44a92432-cfd3-0c4f-8caf-fc2b91f296a7"],
 ", ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "1422188d-dff0-3f49-8e3f-5f43c02b8aa0"],
 " and ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "7e78fb7f-e0fb-0e46-adce-559516e2ae30"],
 ", which have been introduced. Just as one would expect by analogy to an \
indexed summation, ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "875f2ea6-ad35-8d4b-b30a-d8c707b913f0"],
 ", ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "7b2ac25b-3b3d-8741-9747-1f4c89c76519"],
 " and ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "59bf857b-5b0a-514c-8bfc-1d0a7d00b3d0"],
 " take on the initial value of ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "0ec0f317-62c1-644e-85c9-4cd967543017"],
 " and are incremented until the specified final values are reached: here, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "k"}], TraditionalForm]],ExpressionUUID->
  "95ef70d7-656b-f84c-867d-a3fedbb9d28e"],
 ", ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]],ExpressionUUID->
  "fb94d394-6ead-4249-87d1-0db610af3e3d"],
 ", and infinity, respectively. Assuming the pattern has been well \
established and will continue indefinitely, we have succeeded in summarizing \
the entire infinite network\[CloseCurlyQuote]s EDSL in one or two scant lines!"
}], "Text",
 CellChangeTimes->{{3.94190662425576*^9, 3.941906636944277*^9}, {
   3.94192068962619*^9, 3.941921037019467*^9}, {3.941941215205035*^9, 
   3.9419412563901196`*^9}, {3.942068321429924*^9, 3.942068338873207*^9}, 
   3.942229415897701*^9, 3.942229869027149*^9, 3.9424333562689266`*^9, {
   3.947158298736447*^9, 3.947158301216999*^9}, {3.9471583334773445`*^9, 
   3.947158336681322*^9}, {3.947767360724385*^9, 3.947767368100273*^9}, {
   3.9478576884660206`*^9, 
   3.9478577113029547`*^9}},ExpressionUUID->"a93904de-6298-8e4e-adde-\
e5e8c96ff037"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3 Notation and Precedents", "Section",
 CellChangeTimes->{{3.9404149812682943`*^9, 3.940414982093226*^9}, {
   3.940415046112516*^9, 3.940415050992111*^9}, {3.941909126506981*^9, 
   3.941909128262066*^9}, {3.941921087777672*^9, 3.941921137316384*^9}, 
   3.941938242142432*^9, {3.9465549503787575`*^9, 3.94655495097019*^9}, {
   3.947343578543774*^9, 
   3.947343585083969*^9}},ExpressionUUID->"1ee213f1-89bb-f94e-96b3-\
70782735f514"],

Cell["\<\
We define the operators both for standard and indexed concatenation, \
explaining the background of the current indexed concatenation notation. \
\>", "Text",
 CellChangeTimes->{{3.946555016163501*^9, 
  3.946555019248375*^9}},ExpressionUUID->"103e56d1-75f7-424e-ab72-\
b3ab54d30cb8"],

Cell[CellGroupData[{

Cell["3.1 Binary (Infix) Operator", "Subsubsection",
 CellChangeTimes->{
  3.944482551849591*^9, {3.9444825865675898`*^9, 3.944482590515889*^9}, {
   3.9444829373250933`*^9, 3.944482942846035*^9}, {3.944483006853173*^9, 
   3.944483011685659*^9}, {3.946555027193588*^9, 
   3.946555027725708*^9}},ExpressionUUID->"91466765-3eb6-4ac9-b1cd-\
a9f32e1451ee"],

Cell[TextData[{
 "There is no generally accepted binary operator for concatenation. Different \
programming languages implement different operators for strings, such as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "+", 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"6e501c69-9878-b248-9927-13f6186e2f8c"],
 " in C++, Java, Pascal, and Python; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], " ", ".", " ", 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"6c158a20-2ace-5745-89a0-a75eaaf09281"],
 " in PHP and Perl, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "*", 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"ff30a4dc-058d-d84a-8fe8-b389806345ba"],
 " in Julia; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "||", 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"3e0e5d78-3be4-3e4f-9695-e49f13cf4ff3"],
 " in SQL; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["S", "1"], "&"}], 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"7621d88b-8964-224e-9c0e-c2394616ff5c"],
 " in Ada, BASIC, and .NET; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "~", 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"ba0c3893-75d8-9047-a0c4-696be655897f"],
 " in D, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "//", 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"1df64258-29e7-a54d-b851-5a39e8aabdb5"],
 " in Fortran, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "^", 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"697ec84a-fb62-a742-850e-d4a0657d2c1a"],
 " in F#; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["S", "1"], ".."}], 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"e484c4d7-680f-3a44-9af7-71e9d805509e"],
 " in Lua; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], " ", ",", 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"db44c687-05f3-1e41-946a-a0341894105e"],
 " in Smalltalk and APL; and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "<>", 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"d7e4a14b-f16b-704e-83ad-cff74b7bb642"],
 " in Wolfram Mathematica. ",
 "In our opinion, each of these options has significant drawbacks, each \
having widely varying meanings in other contexts. Nor would the situation be \
improved by importing the function composition operator used in mathematics: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "1"], "\[SmallCircle]", 
    SubscriptBox["f", "2"]}], TraditionalForm]],ExpressionUUID->
  "f168ef81-dbf4-4749-bec9-4b5883a7a5ea"],
 "."
}], "Text",
 CellChangeTimes->{{3.944485459282819*^9, 3.9444856544119596`*^9}, {
   3.944485977797839*^9, 3.944485983301809*^9}, {3.944486104644629*^9, 
   3.944486111685684*^9}, {3.944501231249485*^9, 3.944501241410639*^9}, {
   3.944509014825575*^9, 3.944509022802343*^9}, {3.944509392786947*^9, 
   3.944509509009696*^9}, {3.946555145571897*^9, 3.946555188256719*^9}, {
   3.947343671747227*^9, 3.9473436840839825`*^9}, 3.9473437210986824`*^9, {
   3.947344445251406*^9, 3.9473444469037457`*^9}, {3.94734467022447*^9, 
   3.947344675497822*^9}, {3.947677845458054*^9, 3.9476778646345806`*^9}, {
   3.947677936905262*^9, 3.94767794874186*^9}, {3.947857768642004*^9, 
   3.947857981694063*^9}, 
   3.947862052699593*^9},ExpressionUUID->"d41f16ba-8c26-4c80-a7d1-\
15c3540bc4e4"],

Cell["\<\
\tSeveral languages, including Haskell, Zig, and Erlang use two consecutive \
plus signs (++) for concatenation, and in the case of Haskell, the shifted \
overstrike (Unicode 10746, hex 29FA): \:29fa. This symbol overcomes many of \
the drawbacks of the others. We propose to use it as the binary or infix \
version of concatenation. For example, we write\
\>", "Text",
 CellChangeTimes->{{3.944485459282819*^9, 3.9444856544119596`*^9}, {
   3.944485977797839*^9, 3.944485983301809*^9}, {3.944486104644629*^9, 
   3.944486111685684*^9}, {3.944501231249485*^9, 3.944501241410639*^9}, {
   3.944509014825575*^9, 3.944509022802343*^9}, {3.944509392786947*^9, 
   3.944509509009696*^9}, {3.946555145571897*^9, 3.946555188256719*^9}, {
   3.947343671747227*^9, 3.9473436840839825`*^9}, 3.9473437210986824`*^9, {
   3.947344445251406*^9, 3.9473444469037457`*^9}, {3.94734467022447*^9, 
   3.947344675497822*^9}, {3.947677845458054*^9, 3.9476779137646213`*^9}, {
   3.947677959055613*^9, 
   3.9476779645744476`*^9}},ExpressionUUID->"487ac223-8c01-a541-afc7-\
43feef224409"],

Cell["{1,2,3} \:29fa {5,4,3} \:29fa {7} = {1,2,3,5,4,3,7}", "Text",
 CellChangeTimes->{{3.931275424121492*^9, 3.931275431471372*^9}, {
   3.931275736003562*^9, 3.931275845802483*^9}, 3.93220498779869*^9, {
   3.933878986960705*^9, 3.93387898978202*^9}, {3.9356768535906467`*^9, 
   3.935676863886909*^9}, {3.9356769476050186`*^9, 3.935676965477867*^9}, 
   3.941939565561438*^9, {3.942068708108547*^9, 3.9420687213693066`*^9}, {
   3.947862054368803*^9, 
   3.94786205481518*^9}},ExpressionUUID->"adac4168-5fd3-e943-a25f-\
1da94a700884"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.2 Indexed Operator", "Subsubsection",
 CellChangeTimes->{{3.944482994100856*^9, 3.9444830035083637`*^9}, {
  3.946555120658537*^9, 
  3.946555121011257*^9}},ExpressionUUID->"685a8672-c827-46fe-8f89-\
1fe398ecfd71"],

Cell["\<\
Consider other familiar notations, such as sum, product, and union, both \
simple (binary, two-argument) and indexed operators:\
\>", "Text",
 CellChangeTimes->{{3.845314312800625*^9, 3.8453143269983635`*^9}, {
   3.851975433052054*^9, 3.851975443510944*^9}, {3.852757434293027*^9, 
   3.852757443292274*^9}, {3.852839292986291*^9, 3.852839312457459*^9}, {
   3.852839745759389*^9, 3.852839760112888*^9}, {3.92340720757247*^9, 
   3.923407210687661*^9}, {3.923407636918423*^9, 3.923407694038988*^9}, {
   3.931274124428792*^9, 3.931274130417455*^9}, {3.931928969164657*^9, 
   3.931928971262286*^9}, {3.935676344174761*^9, 3.935676358124407*^9}, {
   3.936039196385202*^9, 3.9360392223922825`*^9}, {3.936127630055807*^9, 
   3.936127669735153*^9}, {3.94192131535351*^9, 3.9419213429626036`*^9}, {
   3.941938255897175*^9, 3.941938314348482*^9}, {3.944482334357185*^9, 
   3.944482337348704*^9}, 3.944482445185063*^9, {3.9444829781624746`*^9, 
   3.944482979170871*^9}},ExpressionUUID->"5ac0b877-357e-4ee0-a2dd-\
db20560b9c01"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   UnderoverscriptBox[
    StyleBox["\[CapitalSigma]",
     FontFamily->"Arial",
     FontSize->18,
     FontWeight->"Normal"], 
    RowBox[{"i", "=", "1"}], "3"], 
   SubscriptBox[
    StyleBox["a",
     FontSlant->"Italic"], "i"]}], "=", 
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["a",
      FontSlant->"Italic"], "1"], "+", 
    SubscriptBox[
     StyleBox["a",
      FontSlant->"Italic"], "2"], "+", 
    RowBox[{
     SubscriptBox[
      StyleBox["a",
       FontSlant->"Italic"], "3"], "\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]", 
     RowBox[{
      UnderoverscriptBox[
       StyleBox["\[Product]",
        FontFamily->"Arial",
        FontSize->12,
        FontWeight->"Normal"], 
       RowBox[{"i", "=", "1"}], "3"], 
      SubscriptBox[
       StyleBox["a",
        FontSlant->"Italic"], "i"]}]}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["a",
       FontSlant->"Italic"], "1"], "\[CenterDot]", 
     SubscriptBox["a", "2"], "\[CenterDot]", 
     SubscriptBox["a", "3"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["a",
         FontSlant->"Italic"], "1"], 
       SubscriptBox[
        StyleBox["a",
         FontSlant->"Italic"], "2"], 
       SubscriptBox[
        StyleBox["a",
         FontSlant->"Italic"], "3"]}], "\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]", 
      UnderoverscriptBox[
       StyleBox["\[Union]",
        FontFamily->"Arial",
        FontSize->14,
        FontWeight->"Normal"], 
       RowBox[{"i", "=", "1"}], "3"], 
      SubscriptBox["S", "i"]}], "=", 
     RowBox[{
      SubscriptBox["S", "1"], 
      StyleBox["\[Union]",
       FontSize->14], 
      SubscriptBox["S", "2"], 
      StyleBox["\[Union]",
       FontSize->14], 
      SubscriptBox["S", "3"]}]}]}]}]}]], "Text",
 CellChangeTimes->{{3.931273726338958*^9, 3.931273749165427*^9}, {
   3.93127378647788*^9, 3.931273903716196*^9}, {3.931273965000884*^9, 
   3.931273993255694*^9}, {3.9361277202268257`*^9, 3.936127760833275*^9}, {
   3.9361278044859085`*^9, 3.9361278325052395`*^9}, 3.936127981570696*^9, 
   3.944482464743483*^9, {3.947858023571863*^9, 
   3.947858034101629*^9}},ExpressionUUID->"e7ea1b84-4427-46f1-ab8b-\
f7eb5ff387a4"],

Cell["Some cases with numbers:", "Text",
 CellChangeTimes->{{3.936138762762472*^9, 
  3.936138785956274*^9}},ExpressionUUID->"c75f751d-dd65-f740-9346-\
cccb787daa53"],

Cell[BoxData[
 RowBox[{
  FormBox[
   TemplateBox[{
     TagBox[
      RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "4"], "i"}], HoldForm], 
     RowBox[{" ", 
       RowBox[{"=", " "}]}], 
     TagBox[
      RowBox[{
        RowBox[{"1", "+", "2", "+", "3", "+", "4"}], "\[LongEqual]", "10"}], 
      HoldForm]},
    "RowDefault"],
   TraditionalForm], "\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]", 
  FormBox[
   TemplateBox[{
     TagBox[
      RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"i", "=", "1"}], "3"], "i"}], HoldForm], 
     RowBox[{" ", 
       RowBox[{"=", " ", 
         RowBox[{
           RowBox[{"1", "\[CenterDot]", "2", "\[CenterDot]", "3"}], " ", "=", 
           " ", 
           RowBox[{
             RowBox[{
               RowBox[{"(", "1", ")"}], 
               RowBox[{"(", "2", ")"}], 
               RowBox[{"(", "3", ")"}]}], " ", "=", " ", "6"}]}]}]}]},
    "RowDefault"],
   TraditionalForm]}]], "Text",
 CellChangeTimes->{{3.931273726338958*^9, 3.931273749165427*^9}, {
   3.93127378647788*^9, 3.931273903716196*^9}, {3.931273965000884*^9, 
   3.931273993255694*^9}, {3.9361277202268257`*^9, 3.936127760833275*^9}, {
   3.9361278044859085`*^9, 3.9361278325052395`*^9}, 3.936127981570696*^9, {
   3.936130399845013*^9, 3.9361304777050705`*^9}, {3.936130513228823*^9, 
   3.9361305855349636`*^9}, {3.93613067025968*^9, 3.936130679856121*^9}, {
   3.936138720658325*^9, 3.9361387319826393`*^9}, {3.936138802078575*^9, 
   3.936138805621761*^9}, {3.947678056096586*^9, 3.947678075484558*^9}, 
   3.947678110340301*^9},ExpressionUUID->"65f58b54-846c-43a5-9eda-\
ed96cf20d42b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   UnderoverscriptBox[
    StyleBox["\[Union]",
     FontFamily->"Arial",
     FontSize->14,
     FontWeight->"Normal"], 
    RowBox[{"i", "=", "1"}], "4"], 
   RowBox[{"{", 
    RowBox[{"i", ",", 
     SuperscriptBox["i", "2"]}], "}"}]}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}], "\[Union]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "4"}], "}"}], "\[Union]", 
    RowBox[{"{", 
     RowBox[{"3", ",", "9"}], "}"}], "\[Union]", 
    RowBox[{"{", 
     RowBox[{"4", ",", "16"}], "}"}]}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "9", ",", "16"}], 
    "}"}]}]}]], "Text",
 CellChangeTimes->{{3.931273726338958*^9, 3.931273749165427*^9}, {
   3.93127378647788*^9, 3.931273903716196*^9}, {3.931273965000884*^9, 
   3.931273993255694*^9}, {3.9361277202268257`*^9, 3.936127760833275*^9}, {
   3.9361278044859085`*^9, 3.9361278325052395`*^9}, 3.936127981570696*^9, {
   3.936130399845013*^9, 3.9361304777050705`*^9}, {3.936130513228823*^9, 
   3.936130612043535*^9}, {3.93613065289712*^9, 
   3.9361307007444515`*^9}},ExpressionUUID->"4e73180e-d45f-42ab-ac43-\
d102fe48758b"],

Cell[TextData[{
 "Each indexed operator is defined as an extension of the corresponding \
binary operator: ",
 Cell[BoxData[
  RowBox[{"+", 
   RowBox[{"\[Implies]", "\[Sum]"}]}]],ExpressionUUID->
  "3b4865e3-5ced-de42-bda2-fad296bd7731"],
 ", ",
 Cell[BoxData[
  RowBox[{"\[CenterDot]", 
   RowBox[{"\[Implies]", "\[Product]"}]}]],ExpressionUUID->
  "b5d00caa-6b0a-774a-9385-58adf61b81f0"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Union]", 
    RowBox[{"\[Implies]", 
     RowBox[{
      StyleBox["\[Union]",
       FontSize->16], 
      StyleBox[" ",
       FontSize->14]}]}]}], TraditionalForm]],ExpressionUUID->
  "66361eea-c3d2-6e4d-bfc3-2e1f37ad9c27"],
 ". The sum and product use different symbols for the two, while the indexed \
union of sets reuses the binary operator symbol for the indexed case, as does \
the intersection. "
}], "Text",
 CellChangeTimes->{{3.936138762762472*^9, 3.936138785956274*^9}, {
   3.941921349209894*^9, 3.941921632780171*^9}, {3.941921679082634*^9, 
   3.941921687127322*^9}, {3.941938369239771*^9, 3.941938401339525*^9}, {
   3.942068422470831*^9, 3.942068424871855*^9}, {3.942248077871481*^9, 
   3.942248083111213*^9}, {3.9465553374207907`*^9, 3.946555342406401*^9}, 
   3.947678262579907*^9, {3.947765485078521*^9, 3.947765488556031*^9}, {
   3.947858084365711*^9, 
   3.947858143781452*^9}},ExpressionUUID->"d035e114-a126-41ac-9e78-\
11c8851b580a"],

Cell["\<\
Having a choice of precedents to follow, we opt for the following for indexed \
concatenation:\
\>", "Text",
 CellChangeTimes->{{3.936138762762472*^9, 3.936138785956274*^9}, {
   3.941921349209894*^9, 3.941921632780171*^9}, {3.941921679082634*^9, 
   3.941921687127322*^9}, {3.941938369239771*^9, 3.941938401339525*^9}, {
   3.942068422470831*^9, 3.942068424871855*^9}, {3.942248077871481*^9, 
   3.942248083111213*^9}, {3.9465553374207907`*^9, 3.946555342406401*^9}, 
   3.947678262579907*^9, {3.9477654850785213`*^9, 
   3.9477654877833424`*^9}},ExpressionUUID->"fdf12768-21da-034b-884d-\
0ddbd1487c16"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   UnderoverscriptBox[
    StyleBox["\[Euro]",
     FontFamily->"Arial",
     FontSize->18], 
    RowBox[{"i", "=", "1"}], "3"], 
   SubscriptBox["S", "i"]}], "=", 
  RowBox[{
   SubscriptBox["S", "1"], "\:29fa", 
   SubscriptBox["S", "2"], "\:29fa", 
   SubscriptBox["S", "3"]}]}]], "Text",
 CellChangeTimes->{{3.931273726338958*^9, 3.931273749165427*^9}, {
   3.93127378647788*^9, 3.931273903716196*^9}, {3.935681284111304*^9, 
   3.9356812907260647`*^9}, {3.936139674182789*^9, 3.9361396842630577`*^9}, 
   3.94767825778487*^9},ExpressionUUID->"dd888db4-1820-4b20-ba3a-\
2fc1f96863b2"],

Cell[TextData[{
 "We settled on the ",
 StyleBox["euro",
  FontSlant->"Italic"],
 " symbol, which exists widely, but not in this context, so no \
misunderstanding should occur. Visually, it resembles a \
\[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote] for \
\[OpenCurlyDoubleQuote]Concatenate\[CloseCurlyDoubleQuote], and also \
resembles our choice for the infix concatenation operator, \
\[OpenCurlyDoubleQuote]\:29fa\[CloseCurlyDoubleQuote], selected from the \
Haskell computer language. "
}], "Text",
 CellChangeTimes->{{3.931276902499031*^9, 3.931276951221378*^9}, {
   3.931278364237862*^9, 3.931278447943572*^9}, 3.9313533608782387`*^9, 
   3.933251942281798*^9, {3.933253195935123*^9, 3.933253242991984*^9}, {
   3.935778537197738*^9, 3.935778559028927*^9}, {3.936130834767061*^9, 
   3.936130856251513*^9}, {3.936136586162588*^9, 3.9361365922601566`*^9}, {
   3.9361388536504765`*^9, 3.936138876248535*^9}, {3.936139784057448*^9, 
   3.936139786249443*^9}, 3.938273694528711*^9, {3.941938693609615*^9, 
   3.941938713266497*^9}, {3.9419387970051994`*^9, 3.941938805386135*^9}, {
   3.942068475287782*^9, 3.942068491379879*^9}, {3.944483035785222*^9, 
   3.944483036952918*^9}, 3.944483175239532*^9, 
   3.947862056111498*^9},ExpressionUUID->"b2554ec7-f9ad-43c9-91d6-\
f0860802280b"],

Cell[TextData[{
 "We begin by closely following t",
 "he indexed union, defining the indexed concatenation in terms of the simple \
operator. Crucially, unlike indexed union, concatenation does not eliminate \
duplicates nor sort the resulting list. For example,\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    UnderoverscriptBox[
     StyleBox["\[Euro]",
      FontFamily->"Arial",
      FontSize->18,
      FontWeight->"Normal"], 
     RowBox[{"i", "=", "1"}], "4"], 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      SuperscriptBox["i", "2"]}], "}"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], "\:29fa", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], "\:29fa", 
     RowBox[{"{", 
      RowBox[{"3", ",", "9"}], "}"}], "\:29fa", 
     RowBox[{"{", 
      RowBox[{"4", ",", "16"}], "}"}]}], "=", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "1", ",", "2", ",", "4", ",", "3", ",", "9", ",", "4", ",", 
      "16"}], "}"}]}]}]], "Text",
  CellChangeTimes->{{3.931273726338958*^9, 3.931273749165427*^9}, {
    3.93127378647788*^9, 3.931273903716196*^9}, {3.931273965000884*^9, 
    3.931273993255694*^9}, {3.9361277202268257`*^9, 3.936127760833275*^9}, {
    3.9361278044859085`*^9, 3.9361278325052395`*^9}, 3.936127981570696*^9, {
    3.936130399845013*^9, 3.9361304777050705`*^9}, {3.936130513228823*^9, 
    3.936130612043535*^9}, {3.93613065289712*^9, 3.9361307007444515`*^9}, {
    3.936130765407639*^9, 3.9361308114004154`*^9}, {3.938011798844099*^9, 
    3.93801180801309*^9}},ExpressionUUID->
  "b514ea2f-140c-4c1b-9ef5-5e20fe291a74"]
}], "Text",
 CellChangeTimes->{
  3.944483168312701*^9, {3.944483233150908*^9, 3.944483282868404*^9}, {
   3.94459458322037*^9, 
   3.944594588394581*^9}},ExpressionUUID->"590950a0-a7a5-4a3e-b088-\
f405cabcd190"],

Cell[TextData[{
 "Similar work has been attempted previously. Nicolaas Govert \
\[OpenCurlyDoubleQuote]Dick\[CloseCurlyDoubleQuote] de Bruijn, a Dutch \
mathematician noted for his contributions to analysis, number theory, \
combinatorics and logic, published a memorandum describing a notation",
 " for both simple and indexed concatenation (de Bruijn 1977). De Bruijn\
\[CloseCurlyQuote]s notation is slightly less intuitive, using a three-sided \
box over each item to be concatenated, forming what he termed ",
 StyleBox["comb notation. ",
  FontSlant->"Italic"],
 "His definitions are solidly rooted in set theory and include a ",
 "recursive definition for the indexed concatenation operator.",
 StyleBox[" ",
  FontSlant->"Italic"],
 "But apparently their time had not yet come. \[OpenCurlyDoubleQuote]This one\
\[CloseCurlyQuote]s for you, Dick!\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{
  3.94448338200101*^9, {3.944501281463221*^9, 3.944501428412241*^9}, {
   3.9445014691683683`*^9, 3.944501694108233*^9}, {3.944501746726098*^9, 
   3.944501820302939*^9}, {3.944509089116304*^9, 3.944509090795434*^9}, {
   3.94450917648752*^9, 3.944509362655952*^9}, {3.94459463096016*^9, 
   3.944594634936409*^9}, 3.944594744133206*^9, {3.946555379818933*^9, 
   3.946555380542341*^9}, {3.9476786392915363`*^9, 3.9476786441939487`*^9}, {
   3.947765608250077*^9, 3.947765609637516*^9}, 
   3.947862057156992*^9},ExpressionUUID->"7fbe1fbb-2e80-4032-bfc1-\
be930f0e4c91"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4 Definitions", "Section",
 CellChangeTimes->{{3.9404149812682943`*^9, 3.940414982093226*^9}, {
   3.940415046112516*^9, 3.940415050992111*^9}, {3.941909126506981*^9, 
   3.941909128262066*^9}, {3.941921087777672*^9, 3.941921137316384*^9}, 
   3.941938242142432*^9, {3.9419391281058617`*^9, 3.941939132320804*^9}, {
   3.941939190357977*^9, 3.9419391923618984`*^9}, {3.9465555553343544`*^9, 
   3.9465555554402733`*^9}},ExpressionUUID->"7b4b6f6c-3767-8e47-a3b9-\
0a4b7794ac14"],

Cell["\<\
We define the concatenation operator as applying to strings, sequences, lists \
(shown here as sets, but with no presumed sorting or removal of duplicates), \
and any other similar objects (Table 3). \
\>", "Text",
 CellChangeTimes->{{3.94193919854654*^9, 3.9419393319831314`*^9}, {
   3.941939367942623*^9, 3.941939390990923*^9}, 3.941939429024763*^9, {
   3.9419404289910603`*^9, 3.941940433943557*^9}, {3.942075671839014*^9, 
   3.94207569490283*^9}, {3.946555565564241*^9, 3.946555575233562*^9}, 
   3.947679741390425*^9},ExpressionUUID->"9412ba35-a47a-0541-8d86-\
4db453b38904"],

Cell["\<\
Table 3: Operation of infix concatenation to various datatypes.\
\>", "Text",
 CellChangeTimes->{{3.94193919854654*^9, 3.9419393319831314`*^9}, {
   3.941939367942623*^9, 3.941939390990923*^9}, 3.941939429024763*^9, {
   3.9419404289910603`*^9, 3.941940433943557*^9}, {3.942075671839014*^9, 
   3.94207569490283*^9}, {3.946555565564241*^9, 3.946555575233562*^9}, 
   3.94767974305686*^9},ExpressionUUID->"34b21de9-187c-a749-9653-\
a067705bfac7"],

Cell[TextData[Cell[BoxData[GridBox[{
   {
    StyleBox["string",
     FontSlant->"Italic"], 
    StyleBox[":",
     FontSlant->"Italic"], 
    StyleBox["\<\"\!\(\*SubscriptBox[\(a\), \(1\)]\)\!\(\*SubscriptBox[\(a\), \
\(2\)]\)\!\(\*SubscriptBox[StyleBox[RowBox[{\"\[Ellipsis]\", StyleBox[\"a\", \
\"InlineFormula\"]}]], \"m\"]\)\"\>", "InlineFormula"], "\:29fa", 
    StyleBox["\<\"\!\(\*SubscriptBox[\(b\), \(1\)]\)\!\(\*SubscriptBox[\(b\), \
\(2\)]\)\!\(\*SubscriptBox[StyleBox[RowBox[{\"\[Ellipsis]\", StyleBox[\"b\", \
\"InlineFormula\"]}]], \"n\"]\)\"\>", "InlineFormula"], "=", 
    StyleBox["\<\"\!\(\*SubscriptBox[\(a\), \(1\)]\)\!\(\*SubscriptBox[\(a\), \
\(2\)]\)\!\(\*SubscriptBox[StyleBox[RowBox[{\"\[Ellipsis]\", StyleBox[\"a\", \
\"InlineFormula\"]}]], \"m\"]\)\!\(\*SubscriptBox[\(b\), \
\(1\)]\)\!\(\*SubscriptBox[\(b\), \
\(2\)]\)\!\(\*SubscriptBox[StyleBox[RowBox[{\"\[Ellipsis]\", StyleBox[\"b\", \
\"InlineFormula\"]}]], \"n\"]\)\"\>", "InlineFormula"]},
   {
    StyleBox["list",
     FontSlant->"Italic"], 
    StyleBox[":",
     FontSlant->"Italic"], 
    StyleBox[
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["a", "1"], ",", 
       SubscriptBox["a", "2"], ",", "\[Ellipsis]", ",", 
       SubscriptBox["a", "m"]}], "}"}], "InlineFormula"], "\:29fa", 
    StyleBox[
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["b", "1"], ",", 
       SubscriptBox["b", "2"], ",", "\[Ellipsis]", ",", 
       SubscriptBox["b", "n"]}], "}"}], "InlineFormula"], "=", 
    StyleBox[
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["a", "1"], ",", 
       SubscriptBox["a", "2"], ",", "\[Ellipsis]", ",", 
       SubscriptBox["a", "m"], ",", 
       SubscriptBox["b", "1"], ",", 
       SubscriptBox["b", "2"], ",", "\[Ellipsis]", ",", 
       SubscriptBox["b", "n"]}], "}"}], "InlineFormula"]},
   {
    StyleBox["sequence",
     FontSlant->"Italic"], 
    StyleBox[":",
     FontSlant->"Italic"], 
    StyleBox[
     RowBox[{"[", 
      RowBox[{
       SubscriptBox["a", "1"], ",", 
       SubscriptBox["a", "2"], ",", "\[Ellipsis]", ",", 
       SubscriptBox["a", "m"]}], "]"}], "InlineFormula"], "\:29fa", 
    StyleBox[
     RowBox[{"[", 
      RowBox[{
       SubscriptBox["b", "1"], ",", 
       SubscriptBox["b", "2"], ",", "\[Ellipsis]", ",", 
       SubscriptBox["b", "n"]}], "]"}], "InlineFormula"], "=", 
    StyleBox[
     RowBox[{"[", 
      RowBox[{
       SubscriptBox["a", "1"], ",", 
       SubscriptBox["a", "2"], ",", "\[Ellipsis]", ",", 
       SubscriptBox["a", "m"], ",", 
       SubscriptBox["b", "1"], ",", 
       SubscriptBox["b", "2"], ",", "\[Ellipsis]", ",", 
       SubscriptBox["b", "n"]}], "]"}], "InlineFormula"]}
  },
  GridBoxDividers->{
   "Columns" -> {False}, 
    "Rows" -> {
     True, {False}, 
      True}}]],ExpressionUUID->"1d5436c9-df8f-0346-ae00-02e7058bd478"]], \
"Text",
 CellChangeTimes->{
  3.947858553976113*^9, {3.947858678790327*^9, 
   3.947858713278904*^9}},ExpressionUUID->"aa84183f-90d0-c247-bc72-\
82f44f2c41e0"],

Cell[TextData[{
 "Notice that the concatenation of two strings results in a string, that of \
two lists gives a list, etc. In all cases this can be thought of as retaining \
the outer delimiters (those before ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "1"], TraditionalForm]],ExpressionUUID->
  "fb03d2b4-e9af-5d41-b6d1-420af6afaf88"],
 " and after ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "n"], TraditionalForm]],ExpressionUUID->
  "81e22ffa-2b93-2140-97c9-3bf8f2339cab"],
 ") while the inner delimiters, those adjacent to the concatenation symbol (",
 StyleBox["\[CloseCurlyDoubleQuote]\[ThinSpace]\:29fa\[ThinSpace]\
\[OpenCurlyDoubleQuote], }\[ThinSpace]\:29fa\[ThinSpace]{, or ]\[ThinSpace]\
\:29fa\[ThinSpace][", "InlineFormula"],
 "), disappear with it: The use of curly braces {} for lists aligns well with \
common usage for ",
 StyleBox["sets",
  FontSlant->"Italic"],
 " in mathematics, where ",
 StyleBox["sequences",
  FontSlant->"Italic"],
 " are often shown without delimiters, and occasionally with parentheses \
(Rehmann, 2020). The square brackets [] used above for sequences is another \
nod to the Haskell language, but we treat this as a ",
 StyleBox["vanishing",
  FontSlant->"Italic"],
 " delimiter. (See below.)"
}], "Text",
 CellChangeTimes->{{3.941939983983751*^9, 3.9419400964580727`*^9}, {
  3.9419401994958563`*^9, 3.941940422194055*^9}, {3.941940696572834*^9, 
  3.941940849502154*^9}, {3.942068840731636*^9, 3.942068844363746*^9}, {
  3.9422482819479427`*^9, 3.942248319659636*^9}, {3.9424335383808136`*^9, 
