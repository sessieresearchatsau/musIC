   3.9465557536383343`*^9}, {3.947765744436884*^9, 
   3.9477657463144007`*^9}},ExpressionUUID->"aae875fe-82f6-6849-8064-\
4d39985dc7dd"],

Cell["\<\
We provide multiple examples of the capabilities of indexed concatenation \
when applied to lists, matrices, and other datatypes. In each case indexed \
concatenations shows promising potential to concisely summarize repeated \
patterns. \
\>", "Text",
 CellChangeTimes->{{3.9404149812682943`*^9, 3.940414982093226*^9}, {
   3.940415046112516*^9, 3.940415050992111*^9}, {3.941909126506981*^9, 
   3.941909128262066*^9}, {3.941921087777672*^9, 3.941921137316384*^9}, 
   3.941938242142432*^9, {3.9419391281058617`*^9, 3.941939132320804*^9}, {
   3.941996282196087*^9, 3.9419962837602787`*^9}, {3.9465557535100937`*^9, 
   3.9465557536383343`*^9}, {3.947765744436884*^9, 
   3.947765750202124*^9}},ExpressionUUID->"eab2151f-9e47-194d-984c-\
84938e194484"],

