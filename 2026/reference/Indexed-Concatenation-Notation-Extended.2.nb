Cell[TextData[{
 "Indexed concatenation (of any ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "283104d8-9f1c-d841-8f3b-cfc621636aa0"],
 " objects ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "i"], TraditionalForm]],ExpressionUUID->
  "f0990292-ac16-7048-b3b5-02c5c832093c"],
 " of the same type) is now defined as a generalization of the binary \
operator: "
}], "Text",
 CellChangeTimes->{{3.941939983983751*^9, 3.9419400964580727`*^9}, {
   3.9419401994958563`*^9, 3.941940421476393*^9}, {3.941940464839498*^9, 
