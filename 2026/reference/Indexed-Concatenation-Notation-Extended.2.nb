      FractionBox["4", "2"], ",", 
      FractionBox["5", "1"]}], "}"}], ",", "\<\"\[Ellipsis]\"\>"}], "}"}],
  DisplayForm]], "Output",
 CellChangeTimes->{{3.944244365871458*^9, 3.9442444563911057`*^9}, 
   3.94424455441362*^9, 3.944244658602247*^9, 3.9442446929039993`*^9, 
