Cell[BoxData[{
 RowBox[{
  RowBox[{"IC2D2", "=", 
   RowBox[{"{", 
    RowBox[{"IndexedConcatenate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"2", " ", "k"}]}], ",", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "k"}]}]}], "}"}], ",", 
      RowBox[{"IndexedConcatenate", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"2", " ", "k"}]}], "}"}], ",", "k"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "12"}], "}"}]}], "]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graph", "[", 
