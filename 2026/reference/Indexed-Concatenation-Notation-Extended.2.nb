Cell[BoxData[{
 RowBox[{
  RowBox[{"nmax", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PTIC1", "=", " ", 
   RowBox[{"IndexedConcatenate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"IndexedConcatenate", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"n", "!"}], 
         RowBox[{
          RowBox[{"k", "!"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "k"}], ")"}], "!"}]}]], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "0", ",", "nmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"PTIC1", ",", " ", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ExpandAll", "[", "PTIC1", "]"}], "}"}], ",", 
       RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "}"}], ",", 
   " ", "\"\<=\>\""}], "]"}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
