Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"switching", " ", "to", " ", "annihilation", " ", "operator"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"aIC1", "=", 
     RowBox[{"{", 
      RowBox[{"IC", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"IC", "[", 
           RowBox[{"0", ",", "k"}], "]"}], ",", 
          RowBox[{"SqrtBox", "[", "k", "]"}], ",", 
          RowBox[{"IC", "[", 
           RowBox[{"0", ",", 
            RowBox[{"7", "-", "2"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "7"}], "}"}]}], "]"}], "}"}]}], ";"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"cIC1", "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"IC", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"IC", "[", 
            RowBox[{"0", ",", 
             RowBox[{"k", "-", "2"}]}], "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"k", "==", "1"}], ",", "Nothing", ",", 
             RowBox[{"SqrtBox", "[", 
              RowBox[{"k", "-", "1"}], "]"}]}], "]"}], ",", 
           RowBox[{"IC", "[", 
            RowBox[{"0", ",", 
             RowBox[{"8", "-", "k"}]}], "]"}], ",", "\"\<\[Ellipsis]\>\""}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "7"}], "}"}]}], "]"}], "}"}], "~", 
      "Cat", "~", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"\"\<\[VerticalEllipsis]\>\"", ",", "7"}], "]"}], "~", "Cat",
         "~", 
        RowBox[{"{", "\"\<\[DescendingEllipsis]\>\"", "}"}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cIC2", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"IC", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"IC", "[", 
           RowBox[{"0", ",", 
            RowBox[{"k", "-", "2"}]}], "]"}], ",", 
          RowBox[{"SqrtBox", "[", 
           RowBox[{"k", "-", "1"}], "]"}], ",", 
