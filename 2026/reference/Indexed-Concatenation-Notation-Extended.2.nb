       RowBox[{"DisplayForm", "@", 
        RowBox[{"MatrixForm", "@", 
         RowBox[{"ExpandAll", "[", "cIC1", "]"}]}]}], ",", "\"\<=\>\"", ",", 
       RowBox[{"DisplayForm", "@", "cIC2"}]}], "\[IndentingNewLine]", "}"}], 
     "}"}], "]"}]}]}]], "Input",
