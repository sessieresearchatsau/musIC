}, Open  ]],

Cell[BoxData[
 TagBox[
  TagBox[
   RowBox[{
    UnderoverscriptBox["\[Euro]", 
     RowBox[{
      StyleBox["diag",
       FontSlant->"Italic"], "\[DoubleRightTee]", "1"}], "\[Infinity]"], 
    RowBox[{"{", 
     TagBox[
      RowBox[{
       UnderoverscriptBox["\[Euro]", 
        RowBox[{
         StyleBox["n",
          FontSlant->"Italic"], "\[DoubleRightTee]", "1"}], 
        StyleBox["diag",
         FontSlant->"Italic"]], 
       RowBox[{"{", 
        FractionBox[
         StyleBox["n",
          FontSlant->"Italic"], 
         RowBox[{"1", "+", 
          StyleBox["diag",
           FontSlant->"Italic"], "-", 
          StyleBox["n",
           FontSlant->"Italic"]}]], "}"}]}],
      DisplayForm], "}"}]}],
   DisplayForm],
  DisplayForm]], "Text",
 CellChangeTimes->{{3.947860106132044*^9, 
  3.9478602017692585`*^9}},ExpressionUUID->"d7d5054a-2036-f249-b271-\
04204681612f"],

Cell["\<\
This enumeration cannot be easily produced by conventional mathematical \
notation, such as using set-builder notation. For example,\
\>", "Text",
 CellChangeTimes->{{3.9422612442970695`*^9, 3.942261245780588*^9}, {
   3.942261720787859*^9, 3.9422617698916607`*^9}, {3.942261920890236*^9, 
   3.9422619960951347`*^9}, {3.94226282297501*^9, 3.942262837272127*^9}, 
   3.947862157594494*^9},ExpressionUUID->"bc115e64-c641-fa48-88e4-\
5dd2090329f9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["p", "q"], "|", "p"}], ",", 
     RowBox[{"q", "\[Element]", 
      SuperscriptBox["\[DoubleStruckCapitalZ]", "+"]}]}], "}"}], 
   TraditionalForm]],ExpressionUUID->"5f760c91-d5aa-734b-a659-2db9c319f925"],
 " \nproduces all fractions, but loses Cantor\[CloseCurlyQuote]s diagonal \
ordering."
}], "Text",
 CellChangeTimes->{{3.94226200151095*^9, 3.942262078554867*^9}, 
   3.947160405215679*^9},ExpressionUUID->"6c5615fc-365c-9f42-839b-\
28b4f709973b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox[
       StyleBox["n",
        FontSlant->"Italic"], 
       RowBox[{
        StyleBox["diag",
         FontSlant->"Italic"], "-", 
        StyleBox["n",
         FontSlant->"Italic"], "+", "1"}]], "|", 
      RowBox[{
       StyleBox["diag",
        FontSlant->"Italic"], "\[Element]", 
       SuperscriptBox["\[DoubleStruckCapitalZ]", "+"]}]}], ",", " ", 
     RowBox[{"n", "\[Element]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "...", ",", " ", 
        StyleBox["diag",
         FontSlant->"Italic"]}], "}"}]}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"2eb6c2dc-c721-7444-bb33-b93798514b0d"],
 " \nagain produces all fractions, but assumes the user will not sort the \
resulting list (i.e., non-standard treatment for sets), and has no interest \
in grouping entries by diagonal. "
}], "Text",
 CellChangeTimes->{{3.94226200151095*^9, 3.94226213668153*^9}, {
   3.942262170102178*^9, 3.942262212894806*^9}, {3.942262260050876*^9, 
   3.942262332755813*^9}, {3.942262365047388*^9, 3.94226240739501*^9}, 
   3.942262461165251*^9, 
   3.947160410177948*^9},ExpressionUUID->"a8d12b69-cb7d-f64e-8522-\
cb420d1d82cf"],

Cell["\<\
The Indexed Concatenation form practically writes itself, while set-builder \
notation requires significant mathematical gymnastics to produce the same \
result.\
\>", "Text",
 CellChangeTimes->{{3.94226200151095*^9, 3.94226213668153*^9}, {
  3.942262170102178*^9, 3.942262212894806*^9}, {3.942262260050876*^9, 
  3.942262332755813*^9}, {3.942262365047388*^9, 3.94226240739501*^9}, {
  3.942262462288816*^9, 
  3.942262522319935*^9}},ExpressionUUID->"b1cfc1bd-bb03-7844-9b3b-\
edf2a2e41e9b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7 A Multiply-Nested Example", "Section",
 CellChangeTimes->{{3.845314312800625*^9, 3.8453143269983635`*^9}, {
   3.851975433052054*^9, 3.851975443510944*^9}, {3.852757434293027*^9, 
   3.852757443292274*^9}, {3.852839292986291*^9, 3.852839312457459*^9}, {
   3.852839745759389*^9, 3.852839760112888*^9}, {3.92340720757247*^9, 
   3.923407210687661*^9}, {3.923407636918423*^9, 3.923407694038988*^9}, {
   3.931274124428792*^9, 3.931274130417455*^9}, {3.931928969164657*^9, 
   3.931928971262286*^9}, {3.935676344174761*^9, 3.935676358124407*^9}, {
   3.936039196385202*^9, 3.9360392223922825`*^9}, {3.936127630055807*^9, 
   3.936127669735153*^9}, {3.936130940340014*^9, 3.93613094168902*^9}, {
   3.936131043765196*^9, 3.936131058245112*^9}, 3.9361367136709957`*^9, {
   3.941988522267773*^9, 3.941988528361128*^9}, {3.947160441489367*^9, 
   3.947160441617483*^9}},ExpressionUUID->"e47e7cd6-6727-4644-8a35-\
4a9a95d86950"],

Cell["\<\
One of the authors created many infinite networks having some visual symmetry \
and patterned structure, identified vertices and edges for the beginning of \
each graph (again following some clear, repeating pattern), constructed its \
EDSL and then reduced it. One interesting case consists of nested, growing, \
interconnected pentagons, as shown in Figure 3.\
\>", "Text",
 CellChangeTimes->{{3.941984370054802*^9, 3.941984518074495*^9}, 
   3.941987456946671*^9, {3.941987524678797*^9, 3.941987592597542*^9}, {
   3.94200948099839*^9, 3.942009511670898*^9}, {3.942069487593555*^9, 
   3.942069524365078*^9}, 3.942229415921911*^9, 3.942241237756508*^9, {
   3.9454608675647755`*^9, 3.945460977229208*^9}, {3.9473431570244846`*^9, 
   3.947343183337902*^9}, {3.947683090844887*^9, 3.947683095861847*^9}, {
   3.947766502555294*^9, 3.94776650805745*^9}, 3.947768365469351*^9, 
   3.94776839680525*^9, 3.9477684778523088`*^9, {3.947860322415453*^9, 
   3.9478603392560196`*^9}},ExpressionUUID->"bb6cec8a-3f02-fc44-90f9-\
14934e27374c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pentagraph", "=", 
   RowBox[{"{", 
    RowBox[{"IndexedConcatenate", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{
         RowBox[{"5", "n"}], "+", "4"}], ",", 
        RowBox[{
         RowBox[{"5", "n"}], "+", "5"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"IndexedConcatenate", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"IndexedConcatenate", "[", 
         RowBox[{
          RowBox[{"{", "1", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"5", "n"}], "+", "5", "+", "k"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"IndexedConcatenate", "[", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "8"}], "}"}]}], "]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graph3D", "[", 
  RowBox[{"FromNetDifferenceSets", "[", 
   RowBox[{"ExpandAll", "[", "pentagraph", "]"}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9234045707337475`*^9, 3.923404575365822*^9}, 
   3.923404692310902*^9, {3.923424404683328*^9, 3.9234244102418957`*^9}, {
   3.931354742888538*^9, 3.931354747161027*^9}, {3.931354917208011*^9, 
   3.931354921801149*^9}, {3.931355535916983*^9, 3.931355540247371*^9}, {
   3.93205301409469*^9, 3.932053017450866*^9}, {3.932053070508981*^9, 
   3.932053074207047*^9}, {3.932217823153547*^9, 3.932217916977254*^9}, {
   3.935683213690668*^9, 3.935683246231753*^9}, {3.941983941112345*^9, 
   3.941984010086859*^9}, {3.9419840463347206`*^9, 3.9419840651678696`*^9}, 
   3.941984100398773*^9, {3.94198746694726*^9, 3.94198748420352*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"1410dd39-87f8-489f-a830-1427bf9155c6"],

