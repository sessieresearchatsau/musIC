      RowBox[{"IndexedConcatenate", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", 
          RowBox[{"2", "+", "i"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "i"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "+", "i"}], ",", 
        RowBox[{"3", "+", "i"}]}], "}"}], ",", 
