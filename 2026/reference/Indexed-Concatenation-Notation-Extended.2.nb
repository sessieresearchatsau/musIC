Cell["\<\
Figure 2 first appeared in (Caviness, 2011), and the code to generate it was \
updated in (Nachbar, 2023). \
\>", "Text",
 CellChangeTimes->{
  3.946556620821911*^9, {3.947682426598984*^9, 3.947682436705223*^9}, {
   3.9476825496107426`*^9, 3.947682551312531*^9}, 3.947682605431221*^9, {
   3.947768239615822*^9, 3.947768240897587*^9}, {3.9477682892556705`*^9, 
   3.947768292488426*^9}},ExpressionUUID->"1a49ca74-2e90-b446-8fad-\
3f5eb86e0d1a"],

Cell[TextData[{
 "The following IC constructs the diagonals in the order Cantor visits them, \
but traverses each diagonal from left-to-right (by increasing numerator), as \
shown by the small blue arrows, before advancing to the next diagonal (longer \
red arrows). We do this by two nested IC objects, the outer specifying the \
diagonal \|01d451\|01d456\|01d44e\|01d454, the inner giving the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\|01d45b", "th"], TraditionalForm]],ExpressionUUID->
  "87e42966-c3ca-3244-bb4d-43860ada4bb9"],
 " element on the diagonal. If the nested list structure is not desired, the \
inner set of curly braces could be replaced by the disappearing square \
brackets, generating sequences that are simply spliced into a single list. "
}], "Text",
 CellChangeTimes->{
  3.946556620821911*^9, {3.947682426598984*^9, 3.947682436705223*^9}, {
   3.9476825496107426`*^9, 3.947682551312531*^9}, 3.947682605431221*^9, {
   3.947768239615822*^9, 3.947768240897587*^9}, 3.9477682892556705`*^9, {
   3.947860032666958*^9, 
   3.947860034828659*^9}},ExpressionUUID->"16f4a5ae-5b80-f745-8bd9-\
140ecfe5a286"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cantor", "=", 
    RowBox[{"{", 
     RowBox[{"IndexedConcatenate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"IndexedConcatenate", "[", 
         RowBox[{
          RowBox[{"FractionBox", "[", 
           RowBox[{"n", ",", 
            RowBox[{"diag", "-", "n", "+", "1"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "diag"}], "}"}]}], "]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"diag", ",", "1", ",", "5"}], "}"}]}], "]"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Style", "[", 
   RowBox[{"\"\<List of diagonals:\>\"", ",", "\"\<Subsubsection\>\""}], 
   "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DisplayForm", "[", 
   RowBox[{
    RowBox[{"ExpandAll", "[", "cantor", "]"}], " ", "~", "Concatenate", "~", 
    " ", 
    RowBox[{"{", "\"\<\[Ellipsis]\>\"", "}"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Style", "[", 
   RowBox[{"\"\<IC reduction:\>\"", ",", "\"\<Subsubsection\>\""}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"DisplayForm", "[", 
  RowBox[{"cantor", " ", "/.", " ", 
   RowBox[{"5", "->", "\[Infinity]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.476135009953125*^9, 3.476135051453125*^9}, {
