Cell["\<\
Here is a small collection of different networks we have successfully \
compressed, each shown together with its compressed edge difference set list \
(EDSL) in indexed concatenation form (IC). All can be extended indefinitely \
by increasing the index end value in the outer indexed concatenation.\
\>", "Text",
 CellChangeTimes->{{3.942067307800569*^9, 3.942067348545939*^9}, {
  3.942069628432268*^9, 3.942069629348493*^9}, {3.942958935302427*^9, 
  3.9429590127362747`*^9}, {3.943362760808119*^9, 3.94336276108272*^9}, {
  3.943374120044817*^9, 3.943374239138323*^9}, {3.947160597744118*^9, 
  3.947160600368996*^9}},ExpressionUUID->"61051000-9af9-aa4e-b4cd-\
d0fcee3b6764"],

Cell["\<\
One network may have multiple possible summarizations, as is demonstrated in \
Figure 4.\
\>", "Text",
 CellChangeTimes->{{3.942067307800569*^9, 3.942067348545939*^9}, {
   3.942069628432268*^9, 3.942069629348493*^9}, {3.942958935302427*^9, 
