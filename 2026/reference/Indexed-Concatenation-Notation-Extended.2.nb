Cell[TextData[{
 "Very concise.  Similarly, the infinite matrix representations of the \
creation operator (",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["a", "^"], "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "34cba2d9-be44-d943-ba2f-9563135867ca"],
 "), the position (",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "^"], TraditionalForm]],ExpressionUUID->
  "daf31aea-1767-2b4d-aaac-0a8ade317fbf"],
 ") and momentum (",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "^"], TraditionalForm]],ExpressionUUID->
  "7949e467-a247-3b44-be82-034651cd1e06"],
 ") operators, can all be written in nested IC form."
}], "Text",
 CellChangeTimes->{{3.94276841394203*^9, 3.942768437080614*^9}, 
   3.94424695600807*^9, 3.947862156321081*^9, 
   3.967543643001032*^9},ExpressionUUID->"34879394-aa3b-774a-a8dc-\
346db5a5b6eb"],

