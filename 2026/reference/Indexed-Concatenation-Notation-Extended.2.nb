Cell[TextData[{
 "In this case no further reduction can be achieved based on exact duplicates \
of adjacent sets or exact duplicates of subsequences, but each 7-element row \
(subsequence) above has a common pattern, with only 3 numbers changing in \
each row. In the first row, these numbers are 5, 2, and 10; in the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "th"], TraditionalForm]],ExpressionUUID->
  "3c154b44-208d-0c40-be03-f2fb9aff49a9"],
 " row, they are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "k"}], "+", "3"}], TraditionalForm]],ExpressionUUID->
  "64b15f2d-6498-3d4e-b9a5-2feecd7f5524"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "k"}], TraditionalForm]],ExpressionUUID->
  "890a435c-5cd0-bf42-8f38-5df779db1237"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "k"}], "+", "8"}], TraditionalForm]],ExpressionUUID->
  "3f3ec5cb-247d-6848-aec1-5d67a366e62f"],
 ". Before moving on to the details of the Indexed Concatenation Notation, \
glance at the fully reduced form of this EDSL in all its glory."
}], "Text",
 CellChangeTimes->{{3.94191983598488*^9, 3.941920017321326*^9}, {
   3.94192006406872*^9, 3.941920066127794*^9}, {3.941920147118603*^9, 
   3.941920164129313*^9}, {3.941920263708113*^9, 3.941920455533069*^9}, {
   3.942068196147732*^9, 3.94206821037861*^9}, {3.942068242546057*^9, 
   3.942068257421568*^9}, 3.942229415892958*^9, {3.9422297770188427`*^9, 
   3.9422297770188427`*^9}, 3.942241236736709*^9, {3.942241638189556*^9, 
   3.942241650927168*^9}, {3.9424333226307354`*^9, 
   3.942433338662926*^9}},ExpressionUUID->"7625bb13-5acf-dc4f-9e9e-\
c3286f6fcee2"],

