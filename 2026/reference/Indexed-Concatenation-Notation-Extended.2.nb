        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{
           RowBox[{"-", "1"}], " ", "+", " ", 
           RowBox[{"2", "^", "k"}], " ", "+", " ", "j"}], ",", " ", 
