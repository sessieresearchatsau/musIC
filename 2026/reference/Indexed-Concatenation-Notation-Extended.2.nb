Cell[BoxData[{
 RowBox[{
  RowBox[{"IC2D1", "=", 
   RowBox[{"{", 
    RowBox[{"IndexedConcatenate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", 
