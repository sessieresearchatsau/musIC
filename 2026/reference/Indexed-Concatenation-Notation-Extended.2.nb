Cell["", "Text",
 CellChangeTimes->{{3.947766643323372*^9, 3.9477666618945656`*^9}, {
   3.9478605435445232`*^9, 3.947860620399441*^9}, 3.947860655153492*^9, {
   3.967653976479664*^9, 3.9676542312742157`*^9}, 3.9676542646535206`*^9},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"cf279e45-0a11-c04c-872b-7a4c0ae28c9e"],

Cell[TextData[{
 "The second version was created by hand, noting the similarities between \
lines 1 and 2 of the first version. Note that the parallels suddenly fail \
towards the ends of the lines, where the second line has two additional \
elements before the final one. In the additionally nested version, these two \
elements were wrapped in ",
 Cell[BoxData[
  TagBox[
   RowBox[{
    OverscriptBox["\[Euro]", 
     StyleBox["m",
      FontSlant->"Italic"]], "[", "\[Ellipsis]", "]"}],
   DisplayForm]],
  CellChangeTimes->{{3.944241671501896*^9, 3.944241686841884*^9}, {
   3.9442470599836864`*^9, 3.944247072322691*^9}, {3.945869133689556*^9, 
   3.94586914009733*^9}, {3.945884356558911*^9, 3.945884356904207*^9}},
  ExpressionUUID->"e6c2d59c-c087-0846-bb86-d9ed94013de3"],
 ", so they are omitted when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "84b44d16-8c9e-d94f-889b-88e059824d33"],
 ", and appear one time when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "e030a1d9-5aea-bb4f-a2af-79e5da7771b2"],
 "."
}], "Text",
 CellChangeTimes->{{3.947766643323372*^9, 3.9477666618945656`*^9}, {
   3.9478605435445232`*^9, 3.947860620399441*^9}, 3.947860655153492*^9, {
   3.967653976479664*^9, 
