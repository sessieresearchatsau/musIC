Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"IC2c", "=", 
    RowBox[{"{", 
     RowBox[{"IndexedConcatenate", "[", 
      RowBox[{
       RowBox[{"IndexedConcatenate", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"k", "+", "1"}]}], "}"}], ",", "k"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "9"}], "}"}]}], "]"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FirstQuadCoords", "[", 
    RowBox[{"n_Integer", " ", "/;", " ", 
     RowBox[{"n", ">", "0"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "diag", ",", "tri"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"diag", "=", 
       RowBox[{"Ceiling", "[", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SqrtBox[
            RowBox[{"1", "+", 
             RowBox[{"8", " ", "n"}]}]]}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tri", "=", 
       RowBox[{"PolygonalNumber", "[", "diag", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"y", "=", 
       RowBox[{"tri", "-", "n"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{"diag", "-", "1", "-", "y"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graph", "[", 
  RowBox[{
   RowBox[{"FromNetDifferenceSets", "[", 
    RowBox[{"ExpandAll", "[", "IC2c", "]"}], "]"}], ",", 
   RowBox[{"VertexLabels", "->", "\"\<Name\>\""}], ",", 
   RowBox[{"DirectedEdges", "->", "True"}], ",", 
   RowBox[{"VertexCoordinates", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "->", 
        RowBox[{"FirstQuadCoords", "[", "#", "]"}]}], "&"}], "/@", " ", 
      RowBox[{"Range", "[", "55", "]"}]}], ")"}]}]}], 
  "]"}], "\[IndentingNewLine]", "IC2c", "\[IndentingNewLine]", 
 RowBox[{"ExpandAll", "@", "IC2c"}]}], "Input",
