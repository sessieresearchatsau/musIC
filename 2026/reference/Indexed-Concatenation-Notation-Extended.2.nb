8d22e6255d3f"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]All diagonal elements are zero. The entries ",
 Cell[BoxData[
  FormBox[
   SqrtBox["n"], TraditionalForm]],ExpressionUUID->
  "7cb85a77-5496-3c40-803b-51a70ce942d4"],
 " appear in the first subdiagonal above the diagonal. All other elements are \
0.\[CloseCurlyDoubleQuote] "
}], "Text",
 CellChangeTimes->{{3.938274885222149*^9, 3.938274890683426*^9}, {
