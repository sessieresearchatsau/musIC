 RowBox[{
  RowBox[{"IC2j", "=", 
   RowBox[{"{", 
    RowBox[{"IndexedConcatenate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], " ", "+", " ", 
         RowBox[{"2", "^", "k"}]}], ",", " ", 
