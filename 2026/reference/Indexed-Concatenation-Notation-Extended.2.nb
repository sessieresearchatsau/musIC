92fe66de763c"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  RowBox[{
   UnderoverscriptBox[
    StyleBox["\[Euro]",
     FontFamily->"Arial",
     FontSize->18], 
    RowBox[{
     StyleBox["i",
      FontSlant->"Italic"], "=", "1"}], 
    StyleBox["n",
     FontSlant->"Italic"]], 
   StyleBox[
    SubscriptBox["S", "i"],
    FontSlant->"Italic"]}], "=", 
  RowBox[{
   StyleBox[
    SubscriptBox["S", "1"],
    FontSlant->"Italic"], "\:29fa", " ", 
   StyleBox[
    SubscriptBox["S", "2"],
    FontSlant->"Italic"], "\:29fa", " ", "\[Ellipsis]", " ", "\:29fa", " ", 
   StyleBox[
    SubscriptBox["S", "n"],
    FontSlant->"Italic"]}]}]], "InlineFormula",
 CellChangeTimes->{{3.931273726338958*^9, 3.931273749165427*^9}, {
  3.93127378647788*^9, 3.931273903716196*^9}, {3.935681284111304*^9, 
