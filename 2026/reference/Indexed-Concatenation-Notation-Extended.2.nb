17d027df70d2"],

Cell[CellGroupData[{

Cell["\<\
Our code to partially or completely expand out Indexed Concatenation lists \
and sequences works for any finite nesting level, but ...\
\>", "ItemNumbered",
 CellChangeTimes->{{3.933250671238449*^9, 3.933250720122751*^9}, {
  3.936039233376049*^9, 3.936039321578685*^9}, {3.9361249773516693`*^9, 
  3.936125000168705*^9}, {3.94198856550214*^9, 3.941988641161505*^9}, {
  3.941988701309187*^9, 3.941988741385653*^9}, {3.941988802854656*^9, 
  3.9419888033206024`*^9}},ExpressionUUID->"4c29babb-f233-45c7-9df4-\
be22355dc93f"],

Cell["\<\
the reverse direction is harder, our algorithm currently identifies and \
reduces 70% of the sample cases attempted. \
\>", "SubitemNumbered",
 CellChangeTimes->{{3.933250671238449*^9, 3.933250720122751*^9}, {
  3.936039233376049*^9, 3.936039321578685*^9}, {3.9361249773516693`*^9, 
  3.936125000168705*^9}, {3.94198856550214*^9, 3.941988641161505*^9}, {
