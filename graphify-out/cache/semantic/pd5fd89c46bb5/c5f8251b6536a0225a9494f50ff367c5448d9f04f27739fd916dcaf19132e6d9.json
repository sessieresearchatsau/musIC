{"nodes": [{"id": "2026_reference_icn_paper_indexed_concatenation_notation__a_novel_way_to_summarize_networks_and_other_complex_systems", "label": "Indexed Concatenation Notation: A Novel Way to Summarize Networks and Other Complex Systems", "file_type": "paper", "source_file": "2026/reference/ICN paper.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "Caviness, Davis, Renck, Sarr, Anderson, Robles, Sharpe", "contributor": null, "venue": "SIMULTECH 2025, pp. 39-50", "doi": "10.5220/0013514700003970"}, {"id": "2026_reference_icn_paper_indexed_concatenation_notation", "label": "Indexed Concatenation Notation", "file_type": "concept", "source_file": "2026/reference/ICN paper.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extends concatenation the way the indexed sum extends addition, giving compact lossless closed-form summaries of strings, lists, matrices and networks with repetitive structure."}, {"id": "2026_reference_icn_paper_concatenation_operator___", "label": "Concatenation Operator ++", "file_type": "concept", "source_file": "2026/reference/ICN paper.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Infix ++ borrowed from Haskell; inner delimiters vanish, no sorting or duplicate removal (unlike union)."}, {"id": "2026_reference_icn_paper_indexed_concatenation_operator__euro_symbol_", "label": "Indexed Concatenation Operator (Euro symbol)", "file_type": "concept", "source_file": "2026/reference/ICN paper.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Euro sign chosen because it resembles a C for Concatenate and is unused in this context, avoiding misunderstanding; modeled on indexed sum/union."}, {"id": "2026_reference_icn_paper_indexed_sum_and_indexed_union_precedents", "label": "Indexed Sum and Indexed Union Precedents", "file_type": "concept", "source_file": "2026/reference/ICN paper.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "2026_reference_icn_paper_edge_difference_set_list__edsl_", "label": "Edge Difference Set List (EDSL)", "file_type": "concept", "source_file": "2026/reference/ICN paper.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replacing ending vertex numbers by differences exposes repeated sets, making network patterns reducible without losing information."}, {"id": "2026_reference_icn_paper_lossless_compression", "label": "Lossless Compression", "file_type": "concept", "source_file": "2026/reference/ICN paper.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "2026_reference_icn_paper_duplicate_subsequence_reduction", "label": "Duplicate Subsequence Reduction", "file_type": "rationale", "source_file": "2026/reference/ICN paper.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collapsing adjacent duplicate sets is the obvious first reduction step, revealing further patterns."}, {"id": "2026_reference_icn_paper_nested_indexed_concatenation", "label": "Nested Indexed Concatenation", "file_type": "concept", "source_file": "2026/reference/ICN paper.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "2026_reference_icn_paper_infinite_networks_in_closed_form", "label": "Infinite Networks in Closed Form", "file_type": "concept", "source_file": "2026/reference/ICN paper.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replacing the outer index end value with infinity yields an infinite network without adding complexity."}, {"id": "2026_refere